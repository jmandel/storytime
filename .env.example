# Copy to .env and fill in. .env is gitignored; never commit real values.
# Family key: base64url of 32 random bytes; `npm run family` makes one. The family link, the call and the books'
# encryption all come from it.
STORYTIME_FAMILY_KEY=
# The family's name, shown in the app (npm run family -- "The Mandels" sets it).
STORYTIME_FAMILY_NAME=
# Optional: the site the family link points at (default: this repo's GitHub Pages address).
STORYTIME_SITE=
# Folder with the book sources (one folder per book with book.json and page images). Not in the repo.
STORYTIME_BOOKS=/home/you/storytime-books
# Local dev server the tests talk to.
STORYTIME_URL=http://127.0.0.1:8092/
# Optional: public HTTPS address of the dev server for trying it on real devices.
STORYTIME_DEV_URL=
